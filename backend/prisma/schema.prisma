model naturaleza {
  id_naturaleza     Int               @id @default(autoincrement())
  nombre_naturaleza String            @db.VarChar(50)
  tipo_movimiento   tipo_movimiento[]
}

model pedido_insumos {
  id_pedido_insumos  Int                  @id @default(autoincrement())
  id_usuario         Int
  fecha_carga        DateTime             @db.Date
  fecha_necesidad    DateTime             @db.Date
  id_estado          Int
  motivo_rechazo     String?              @db.VarChar(255)
  item_pedido_insumo item_pedido_insumo[]
  estados            estados              @relation(fields: [id_estado], references: [id_estado], onUpdate: Restrict, map: "fk_pedido_insumos_estado")
  usuarios           usuarios             @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "fk_pedido_insumos_usuario")

  @@index([id_estado], map: "fk_pedido_insumos_estado")
  @@index([id_usuario], map: "fk_pedido_insumos_usuario")
}

// Camino inverso de pedido_insumos: Producción devuelve a Logística lo
// que le sobró. Lo carga el operario o jefe de Producción, lo aprueba
// o rechaza el jefe de Logística (si rechaza, vuelve editable acá con
// un motivo, igual que pedido_insumos con Rechazado).
model devolucion_insumos {
  id_devolucion_insumos  Int                      @id @default(autoincrement())
  id_usuario             Int
  fecha_carga            DateTime                 @db.Date
  id_estado              Int
  motivo_rechazo         String?                  @db.VarChar(255)
  item_devolucion_insumo item_devolucion_insumo[]
  estados                estados                  @relation(fields: [id_estado], references: [id_estado], onUpdate: Restrict, map: "fk_devolucion_insumos_estado")
  usuarios               usuarios                 @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "fk_devolucion_insumos_usuario")

  @@index([id_estado], map: "fk_devolucion_insumos_estado")
  @@index([id_usuario], map: "fk_devolucion_insumos_usuario")
}

model item_devolucion_insumo {
  id_item_devolucion_insumo Int                 @id @default(autoincrement())
  id_devolucion_insumos     Int
  id_insumo                 Int
  id_lineas                 Int
  cantidad                  Decimal             @db.Decimal(10, 2)
  insumo                    insumo              @relation(fields: [id_insumo], references: [id_insumo], onUpdate: Restrict, map: "fk_item_devolucion_insumo_insumo")
  lineas                    lineas              @relation(fields: [id_lineas], references: [id_lineas], onUpdate: Restrict, map: "fk_item_devolucion_insumo_lineas")
  devolucion_insumos        devolucion_insumos  @relation(fields: [id_devolucion_insumos], references: [id_devolucion_insumos], onDelete: Cascade, onUpdate: Restrict, map: "fk_item_devolucion_insumo_devolucion")
  movimiento_insumo         movimiento_insumo[]

  @@index([id_insumo], map: "fk_item_devolucion_insumo_insumo")
  @@index([id_lineas], map: "fk_item_devolucion_insumo_lineas")
  @@index([id_devolucion_insumos], map: "fk_item_devolucion_insumo_devolucion")
}

model pedidos {
  id_pedido                Int              @id @default(autoincrement())
  id_cliente               Int
  fecha_carga              DateTime         @db.Date
  fecha_prometido          DateTime?        @db.Date
  id_estado                Int
  id_usuario               Int
  // Se completan recién al despachar (ver PedidosService.despachar):
  // depósito de logística de donde salió la mercadería (según el sector
  // del usuario que despacha), cantidad de copias del remito elegida en
  // ese momento, fecha real de despacho, y el PDF generado.
  id_deposito              Int?
  cantidad_copias          Int?
  fecha_despacho           DateTime?        @db.Date
  id_archivo_remito        Int?             @unique
  // Motivo al anular desde "Cargado", o número de nota de débito al
  // anular desde "Facturado" (ver PedidosService.anular).
  motivo_anulacion         String?          @db.VarChar(255)
  nro_nota_debito          String?          @db.VarChar(100)
  // Planificador de Entregas (Caseros): fecha interna que el Jefe de
  // Logística/Comercial le asigna al pedido para organizar la salida
  // — distinta de fecha_prometido (lo que se le dijo al cliente) y de
  // fecha_despacho (cuándo salió realmente). orden_planificador es el
  // desempate manual (arrastrar columna) dentro de un mismo
  // fecha_prometido; ver PlanificadorEntregasService.
  fecha_salida_planificada DateTime?        @db.Date
  orden_planificador       Int?
  item_pedido              item_pedido[]
  clientes                 clientes         @relation(fields: [id_cliente], references: [id_cliente], onUpdate: Restrict, map: "fk_pedidos_cliente")
  estados                  estados          @relation(fields: [id_estado], references: [id_estado], onUpdate: Restrict, map: "fk_pedidos_estado")
  usuarios                 usuarios         @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "fk_pedidos_usuario")
  deposito                 deposito?        @relation(fields: [id_deposito], references: [id_deposito], onUpdate: Restrict, map: "fk_pedidos_deposito")
  archivo_remito           archivo_adjunto? @relation(fields: [id_archivo_remito], references: [id_archivo_adjunto], onDelete: SetNull, onUpdate: Restrict, map: "fk_pedidos_archivo_remito")
  factura                  factura?

  @@index([id_cliente], map: "fk_pedidos_cliente")
  @@index([id_estado], map: "fk_pedidos_estado")
  @@index([id_usuario], map: "fk_pedidos_usuario")
  @@index([id_deposito], map: "fk_pedidos_deposito")
}

model permisos {
  id_permiso     Int            @id @default(autoincrement())
  nombre_permiso String         @db.VarChar(100)
  rol_permisos   rol_permisos[]
}

// Cabecera de la semana (fecha_inicio_semana siempre un lunes, ver
// PlanProduccionService). Se crea sola la primera vez que se carga
// algo en esa semana (item o día no laborable) — no hay un alta manual
// de "plan" como tal, ver PlanProduccionService.obtenerOCrearPlan.
// id_estado queda del diseño original (siempre "Activo" en la
// práctica); el concepto real de "anular" ahora es por día, ver
// dia_no_laborable.
model plan_produccion {
  id_plan_produccion   Int                    @id @default(autoincrement())
  id_usuario           Int
  fecha_inicio_semana  DateTime               @db.Date
  id_estado            Int
  item_plan_produccion item_plan_produccion[]
  dia_no_laborable     dia_no_laborable[]
  estados              estados                @relation(fields: [id_estado], references: [id_estado], onUpdate: Restrict, map: "fk_plan_produccion_estado")
  usuarios             usuarios               @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "fk_plan_produccion_usuario")

  @@index([id_estado], map: "fk_plan_produccion_estado")
  @@index([id_usuario], map: "fk_plan_produccion_usuario")
}

// Un día (lunes a viernes) marcado como no laborable (feriado, día de
// limpieza, etc.) dentro de la semana de un plan: ese día no admite
// item_plan_produccion (se valida en el service, no acá). fecha es
// única globalmente — un día no puede estar marcado dos veces.
model dia_no_laborable {
  id_dia_no_laborable Int             @id @default(autoincrement())
  id_plan_produccion  Int
  fecha               DateTime        @unique(map: "uq_dia_no_laborable_fecha") @db.Date
  motivo              String          @db.VarChar(255)
  plan_produccion     plan_produccion @relation(fields: [id_plan_produccion], references: [id_plan_produccion], onDelete: Cascade, onUpdate: Restrict, map: "fk_dia_no_laborable_plan")

  @@index([id_plan_produccion], map: "fk_dia_no_laborable_plan")
}

model productos {
  id_producto             Int                       @id @default(autoincrement())
  codigo_producto         String                    @db.VarChar(50)
  descripcion_producto    String                    @db.VarChar(200)
  bolsones_por_pallet     Int?
  peso_por_bolson         Decimal?                  @db.Decimal(10, 2)
  precio_venta            Decimal                   @db.Decimal(10, 2)
  stock_actual            Int                       @default(0)
  stock_minimo            Int                       @default(0)
  id_estado               Int
  id_archivo_adjunto      Int?
  id_tipo_producto        Int?
  item_pedido             item_pedido[]
  item_plan_produccion    item_plan_produccion[]
  item_prod               item_prod[]
  movimiento_producto     movimiento_producto[]
  estados                 estados                   @relation(fields: [id_estado], references: [id_estado], onUpdate: Restrict, map: "fk_productos_estado")
  // A diferencia de compra/cotizacion (Restrict), acá es SetNull: la foto
  // de un producto se reemplaza/borra sueltamente desde el formulario
  // (sube/borra el archivo_adjunto antes de guardar el producto), así que
  // el borrado del archivo no puede quedar bloqueado por esta FK.
  archivo_adjunto         archivo_adjunto?          @relation(fields: [id_archivo_adjunto], references: [id_archivo_adjunto], onDelete: SetNull, onUpdate: Restrict, map: "fk_productos_archivo_adjunto")
  tipo_producto           tipo_producto?            @relation(fields: [id_tipo_producto], references: [id_tipo_producto], onUpdate: Restrict, map: "fk_productos_tipo_producto")
  receta                  receta[]
  ajuste_stock            ajuste_stock[]
  item_lote               item_lote[]
  stock_producto_deposito stock_producto_deposito[]
  bobina                  bobina[]
  pallet                  pallet[]

  @@index([id_estado], map: "fk_productos_estado")
  @@index([id_archivo_adjunto], map: "fk_productos_archivo_adjunto")
  @@index([id_tipo_producto], map: "fk_productos_tipo_producto")
}

// Clasificación del producto (Bobina, Producto procesado, Producto
// tercerizado, ...) pensada para indicadores más adelante. Por ahora
// solo se usa para decidir si un ítem se muestra en "Kg" o en
// "Bolsones" en pedidos/remitos (ver PedidosList y RemitoPdfService).
model tipo_producto {
  id_tipo_producto Int         @id @default(autoincrement())
  descripcion      String      @db.VarChar(100)
  productos        productos[]
}

