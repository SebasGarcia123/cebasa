  deposito                 deposito @relation(fields: [id_deposito], references: [id_deposito], onUpdate: Restrict, map: "fk_stock_insumo_dep_deposito")
  insumo                   insumo   @relation(fields: [id_insumo], references: [id_insumo], onUpdate: Restrict, map: "fk_stock_insumo_dep_insumo")

  @@unique([id_insumo, id_deposito], map: "uq_insumo_deposito")
  @@index([id_deposito], map: "fk_stock_insumo_dep_deposito")
}

// Desglose de stock de productos terminados por depósito (antes solo
// existía para insumos). productos.stock_actual sigue siendo el total
// cacheado; esta tabla es la que hace falta para saber cuánto hay en
// cada planta, y la que LotesService.aprobar mueve en un interplanta.
model stock_producto_deposito {
  id_stock_producto_deposito Int       @id @default(autoincrement())
  id_producto                Int
  id_deposito                Int
  cantidad                   Int       @default(0)
  deposito                   deposito  @relation(fields: [id_deposito], references: [id_deposito], onUpdate: Restrict, map: "fk_stock_producto_dep_deposito")
  productos                  productos @relation(fields: [id_producto], references: [id_producto], onUpdate: Restrict, map: "fk_stock_producto_dep_producto")

  @@unique([id_producto, id_deposito], map: "uq_producto_deposito")
  @@index([id_deposito], map: "fk_stock_producto_dep_deposito")
}

