model sectores {
  id_sector    Int        @id @default(autoincrement())
  nombreSector String     @db.VarChar(100)
  // A qué planta pertenece este sector (null para los que no son de
  // ninguna planta en particular, ej. Administracion/Comercial). No se
  // infiere de nombreSector — ver PlantaLookupService.
  planta       Planta?
  usuarios     usuarios[]
  reclamos     reclamos[]
}

// Únicas dos plantas de la empresa. Es un enum (no una tabla) a
// propósito: código como LoteProdService.assertMismaPlanta compara
// contra estos valores, así que tienen que ser estables — a diferencia
// de nombreSector/nombre_deposito, que son solo el rótulo visible y se
// pueden renombrar libremente sin romper nada.
enum Planta {
  CASEROS
  BARADERO
}

// Clasifica un depósito como de logística (mercadería terminada, lista
// para despachar) o de producción (planta, insumos/consumo). Mismo
// criterio que Planta: enum estable, no un nombre parseado.
enum RolDeposito {
  LOGISTICA
  PRODUCCION
}

