model tipo_bobina {
  id_tipo_bobina Int      @id @default(autoincrement())
  descripcion    String   @db.VarChar(100)
  bobina         bobina[]
}

// Una fila por rollo físico producido (a diferencia de item_prod, que
// es cantidad agregada): cada bobina se imprime con su propio rótulo +
// QR con estos mismos datos. Vive dentro de un lote_prod de Producción
// Baradero (fecha+turno, se va cargando hasta que se cierra), pero el
// modelo no fuerza la planta — technically cualquier lote_prod podría
// tener bobinas si hiciera falta más adelante.
model bobina {
  id_bobina         Int         @id @default(autoincrement())
  // Identificador visible/de negocio: prefijo de 2 letras + 4 dígitos
  // (ej. "AA0001"), lo arma BobinaService.siguienteNumero a partir de
  // bobina_secuencia — nunca lo escribe el operario a mano.
  numero_bobina     String      @unique(map: "uq_bobina_numero_bobina") @db.VarChar(6)
  id_lote           Int
  id_tipo_bobina    Int
  id_producto       Int
  peso              Decimal     @db.Decimal(10, 2)
  gramaje           Decimal     @db.Decimal(10, 2)
  id_usuario        Int
  fecha_elaboracion DateTime    @default(now())
  lote_prod         lote_prod   @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade, onUpdate: Restrict, map: "fk_bobina_lote")
  tipo_bobina       tipo_bobina @relation(fields: [id_tipo_bobina], references: [id_tipo_bobina], onUpdate: Restrict, map: "fk_bobina_tipo_bobina")
  productos         productos   @relation(fields: [id_producto], references: [id_producto], onUpdate: Restrict, map: "fk_bobina_producto")
  usuarios          usuarios    @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "fk_bobina_usuario")

  @@index([id_lote], map: "fk_bobina_lote")
  @@index([id_tipo_bobina], map: "fk_bobina_tipo_bobina")
  @@index([id_producto], map: "fk_bobina_producto")
  @@index([id_usuario], map: "fk_bobina_usuario")
}

// Fila única (id=1) que lleva la numeración global de bobinas: prefijo
// de 2 letras + contador de 4 dígitos. Al pasar de 9999 se incrementa
// el prefijo (AA -> AB -> ... -> AZ -> BA...) y el contador vuelve a 1.
// UPDATE sobre esta fila toma lock de fila en InnoDB, así que sirve
// para serializar altas concurrentes de bobina sin pisarse.
model bobina_secuencia {
  id      Int    @id
  prefijo String @db.VarChar(2)
  numero  Int
}

// Una fila por pallet físico cargado por el operario de Producción
// Caseros (a diferencia de item_prod, que sigue siendo cantidad
// agregada cargada a mano por el Jefe). numero_lote es un código de
// trazabilidad, no un serial único por fila: se arma en
// PalletService.numeroLote como fecha(DDMMAA)-código_producto, así que
// se repite en todos los pallets del mismo producto del mismo día a
// propósito (identifica el lote de fabricación, no la unidad física).
model pallet {
  id_pallet         Int       @id @default(autoincrement())
  numero_lote       String    @db.VarChar(20)
  id_lote           Int
  id_producto       Int
  id_lineas         Int
  cantidad_bolsones Int
  id_usuario        Int
  fecha_elaboracion DateTime  @default(now())
  lote_prod         lote_prod @relation(fields: [id_lote], references: [id_lote], onDelete: Cascade, onUpdate: Restrict, map: "fk_pallet_lote")
  productos         productos @relation(fields: [id_producto], references: [id_producto], onUpdate: Restrict, map: "fk_pallet_producto")
  lineas            lineas    @relation(fields: [id_lineas], references: [id_lineas], onUpdate: Restrict, map: "fk_pallet_lineas")
  usuarios          usuarios  @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "fk_pallet_usuario")

  @@index([id_lote], map: "fk_pallet_lote")
  @@index([id_producto], map: "fk_pallet_producto")
  @@index([id_lineas], map: "fk_pallet_lineas")
  @@index([id_usuario], map: "fk_pallet_usuario")
}

// Lote interplanta: traslado de productos/insumos entre depósitos de
// logística de distinta planta (Baradero <-> Caseros). Editable
// mientras está "Pendiente"; al despachar pasa a "Pendiente de
// aprobación" y la revisa el Jefe de Logística de la planta DESTINO
// (mismo patrón que lote_prod, pero acá "la misma planta" se valida
// contra el depósito destino, no contra uno solo). id_deposito_origen
// e id_deposito_destino quedan opcionales a nivel de columna porque el
// modelo es compartido con otros tipo_lote que no los necesiten, pero
// LotesService los exige (y distintos entre sí) para tipo "Interplanta".
model lotes {
  id_lote             Int         @id @default(autoincrement())
  fecha_lote          DateTime    @db.Date
  id_chofer           Int
  id_camion           Int
  id_tipo_lote        Int
  id_estado           Int
  id_deposito_origen  Int?
  id_deposito_destino Int?
  fecha_despacho      DateTime?   @db.Date
  observaciones       String?     @db.VarChar(255)
  motivo_rechazo      String?     @db.VarChar(255)
  item_lote           item_lote[]
  camion              camion      @relation(fields: [id_camion], references: [id_camion], onUpdate: Restrict, map: "fk_lotes_camion")
  chofer              chofer      @relation(fields: [id_chofer], references: [id_chofer], onUpdate: Restrict, map: "fk_lotes_chofer")
  estados             estados     @relation(fields: [id_estado], references: [id_estado], onUpdate: Restrict, map: "fk_lotes_estado")
  tipo_lote           tipo_lote   @relation(fields: [id_tipo_lote], references: [id_tipo_lote], onUpdate: Restrict, map: "fk_lotes_tipo_lote")
  deposito_origen     deposito?   @relation("lotes_deposito_origen", fields: [id_deposito_origen], references: [id_deposito], onUpdate: Restrict, map: "fk_lotes_deposito_origen")
  deposito_destino    deposito?   @relation("lotes_deposito_destino", fields: [id_deposito_destino], references: [id_deposito], onUpdate: Restrict, map: "fk_lotes_deposito_destino")

  @@index([id_camion], map: "fk_lotes_camion")
  @@index([id_chofer], map: "fk_lotes_chofer")
  @@index([id_estado], map: "fk_lotes_estado")
  @@index([id_tipo_lote], map: "fk_lotes_tipo_lote")
  @@index([id_deposito_origen], map: "fk_lotes_deposito_origen")
  @@index([id_deposito_destino], map: "fk_lotes_deposito_destino")
}

model movimiento_cuenta_corriente {
  id_movimiento_cta_cte Int              @id @default(autoincrement())
  fecha                 DateTime         @db.Date
  monto                 Decimal          @db.Decimal(10, 2)
  id_tipo_documento     Int
  saldo_resultante      Decimal          @db.Decimal(10, 2)
  id_cuenta_corriente   Int
  // Exactamente uno de estos cuatro va completo, según el tipo de
  // documento que generó el movimiento (ver DocumentosService). No hay
  // constraint de base para "exactamente uno de cuatro" en MySQL, se
  // valida en el service, igual que ajuste_stock con insumo/producto.
  id_factura            Int?             @unique
  id_recibo             Int?             @unique
  id_nota_credito       Int?             @unique
  id_nota_debito        Int?             @unique
  cuenta_corriente      cuenta_corriente @relation(fields: [id_cuenta_corriente], references: [id_cuenta_corriente], onUpdate: Restrict, map: "fk_movimiento_cta_cte_cuenta")
  tipo_documento        tipo_documento   @relation(fields: [id_tipo_documento], references: [id_tipo_documento], onUpdate: Restrict, map: "fk_movimiento_cta_cte_tipo_doc")
  factura               factura?         @relation(fields: [id_factura], references: [id_factura], onDelete: Restrict, onUpdate: Restrict, map: "fk_movimiento_cta_cte_factura")
  recibo                recibo?          @relation(fields: [id_recibo], references: [id_recibo], onDelete: Restrict, onUpdate: Restrict, map: "fk_movimiento_cta_cte_recibo")
  nota_credito          nota_credito?    @relation(fields: [id_nota_credito], references: [id_nota_credito], onDelete: Restrict, onUpdate: Restrict, map: "fk_movimiento_cta_cte_nota_credito")
  nota_debito           nota_debito?     @relation(fields: [id_nota_debito], references: [id_nota_debito], onDelete: Restrict, onUpdate: Restrict, map: "fk_movimiento_cta_cte_nota_debito")

  @@index([id_cuenta_corriente], map: "fk_movimiento_cta_cte_cuenta")
  @@index([id_tipo_documento], map: "fk_movimiento_cta_cte_tipo_doc")
}

model movimiento_insumo {
